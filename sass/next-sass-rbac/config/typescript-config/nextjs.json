{
  "extends": "@saas/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "baseUrl": ".",
      "@/*": [
        "./src/*"
      ]
    },
    "include": [
      "next-env.d.ts",
      "**/*.ts",
      "**/*.tsx",
      ".next/types/**/*.ts",
      ".next/dev/types/**/*.ts",
      "**/*.mts"
    ],
    "exclude": [
      "node_modules"
    ]
  }
}